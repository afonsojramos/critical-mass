amends "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl"

steps {
  ["format"] {
    glob = "**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,scss,less,md,mdx,yml,yaml,html}"
    check = "pnpm exec vp fmt --check --no-error-on-unmatched-pattern {{files}}"
    fix = "pnpm exec vp fmt --write --no-error-on-unmatched-pattern {{files}}"
  }
  ["lint"] {
    glob = "**/*.{ts,tsx,js,jsx,mjs,cjs}"
    check = "pnpm exec vp lint {{files}}"
    fix = "pnpm exec vp lint --fix {{files}}"
    depends = "format"
  }
  ["typecheck"] {
    check = "pnpm exec tsc --noEmit"
    depends = List("format", "lint")
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
  }
}
