    "@cloudflare/kumo": "2.6.0",
    "@emdash-cms/admin": "^0.32.0",
    "@emdash-cms/auth-atproto": "^0.2.32",
    "@emdash-cms/cloudflare": "^0.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "astro": "^7.2.0",
    "astro-navbar": "^2.4.0",
    "astro-portabletext": "^0.13.0",
    "blockrate": "^1.1.0",
    "emdash": "^0.32.0",
    "emdash-plugin-bulk-upload": "^0.1.0",
    "husky": "^9.1.7",
    "lenis": "^1.3.26",
    "node-html-parser": "^9.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
