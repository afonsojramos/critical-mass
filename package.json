    "@inlang/paraglide-js": "^2.23.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vite-plus": "^0.2.8",
    "wrangler": "^4.120.1"
