---
import { ClientRouter } from "astro:transitions";
import Seo from "@/components/seo/Seo.astro";
import { getSiteCopy } from "@/i18n/site-copy";

// `clientRouter` opts a page into view-transition (client-side) navigation;
// only navigations between two opted-in pages are swapped client-side.
const { title, description, image, frontmatter, robots, clientRouter } = Astro.props;
const m = await getSiteCopy(Astro.currentLocale);

const formattedTitle = title ? `${title} - ${m.title}` : m.title;
---

<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta name="viewport" content="width=device-width" />
  <meta name="generator" content={Astro.generator} />

  <title>{formattedTitle}</title>
  <meta name="description" content={description} />

  <Seo
    title={formattedTitle}
    {description}
    url={Astro.url.toString()}
    {image}
    {frontmatter}
    {robots}
  />

  <!-- Preconnect fonts, images... -->
  <script defer is:inline src="https://rybbit.afonsojramos.me/api/script.js" data-site-id="0806a857a038"></script>
  {clientRouter && <ClientRouter />}
</head>
