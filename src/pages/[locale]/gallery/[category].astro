---
export const prerender = false;

import { getTaxonomyTerms } from "emdash";
import GalleryView from "@/components/sections/GalleryView.astro";
import { getSiteCopy } from "@/i18n/site-copy";
import MainLayout from "@/layouts/MainLayout.astro";
import { termLocaleSwitchHref } from "@/utils/localeSwitch";

const { category } = Astro.params;
const locale = Astro.currentLocale as "pt" | "en";
const m = await getSiteCopy(locale);

// Page title from the category taxonomy term label (falls back to the slug).
const terms = await getTaxonomyTerms("category", { locale });
const categoryLabel = terms.find((t) => t.slug === category)?.label ?? category;
const categoryTitle = `${m.gallery_title} - ${categoryLabel}`;

// Language switch lands on this category's translated term URL.
const localeSwitchHref = await termLocaleSwitchHref("category", category as string, locale, "gallery", "gallery");

Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=3600");
---

<MainLayout
  title={categoryTitle}
  description={m.gallery_description}
  localeSwitchHref={localeSwitchHref}
  clientRouter
>
  <GalleryView filterCategory={category} />
</MainLayout>
