---
import { getEmDashCollection, getTaxonomyTerms } from "emdash";
import GalleryCard from "@/components/ui/GalleryCard.astro";
import ImageModal from "@/components/ui/ImageModal.astro";
import { galleryPeriodRange, normalizeGalleryPeriod } from "@/gallery-period";
import { getSiteCopy } from "@/i18n/site-copy";
import { capitalize } from "@/utils";
import { resolveBaseTermSlug } from "@/utils/taxonomy";

interface Props {
  filterCategory?: string;
}

const { filterCategory = "all" } = Astro.props;
const locale = Astro.currentLocale as "pt" | "en";
const m = await getSiteCopy(locale);

// Canonical filter params are `year` and `month`; `period` (YYYY or YYYY-MM)
// is still accepted so old links keep working.
const params = Astro.url.searchParams;
const requestedPeriod = params.get("period") ?? "";
const legacyMonth = normalizeGalleryPeriod(requestedPeriod);
const YEAR_PATTERN = /^\d{4}$/;
const MONTH_PATTERN = /^(0[1-9]|1[0-2])$/;
let selectedYear = params.get("year") ?? "";
let selectedMonth = params.get("month") ?? "";
if (!selectedYear && legacyMonth === requestedPeriod && legacyMonth) {
  [selectedYear, selectedMonth] = requestedPeriod.split("-");
} else if (!selectedYear && YEAR_PATTERN.test(requestedPeriod)) {
  selectedYear = requestedPeriod;
}
if (!YEAR_PATTERN.test(selectedYear)) selectedYear = "";
if (!selectedYear || !MONTH_PATTERN.test(selectedMonth)) selectedMonth = "";
const requestedLocation = params.get("location") ?? "";

// Gallery content is single-locale: posters are proper names, so only the
// base-locale rows exist and both language versions of the page show them.
// City names are proper nouns, so the canonical location row is also
// suitable for the localized filter label.
const [{ entries: locationEntries }, categoryTerms, { entries: allGalleryEntries }] =
  await Promise.all([
    getEmDashCollection("locations", { status: "published", locale: "pt" }),
    getTaxonomyTerms("category", { locale }),
    getEmDashCollection("gallery", { status: "published", locale: "pt" }),
  ]);

// Only offer locations that actually have gallery entries (including
// inactive historical ones such as Setúbal) so no filter is a dead end.
const usedLocationIds = new Set(
  (allGalleryEntries as any[])
    .map((entry) => entry.data.location)
    .filter(Boolean)
    .map(String),
);
const locations = (locationEntries as any[])
  .filter((location) => usedLocationIds.has(String(location.data.id)))
  .map((location) => ({
    ...location,
    referenceId: String(location.data.id),
    slug: location.id,
  }))
  .sort((a, b) => String(a.data.city).localeCompare(String(b.data.city), locale));
const selectedLocation = locations.find((location) => location.slug === requestedLocation);

const yearSet = new Set(
  (allGalleryEntries as any[])
    .map((entry) => String(entry.data.date ?? "").slice(0, 4))
    .filter((year) => YEAR_PATTERN.test(year)),
);
if (selectedYear) yearSet.add(selectedYear);
const years = [...yearSet].sort((a, b) => b.localeCompare(a));

const monthName = (month: string) =>
  capitalize(
    new Intl.DateTimeFormat(locale === "en" ? "en-GB" : "pt-PT", {
      month: "long",
      timeZone: "UTC",
    }).format(new Date(Date.UTC(2000, Number(month) - 1, 1))),
  );
const months = Array.from({ length: 12 }, (_, index) =>
  String(index + 1).padStart(2, "0"),
);

const selectedPeriod = selectedYear
  ? selectedMonth
    ? `${selectedYear}-${selectedMonth}`
    : selectedYear
  : "";

type GalleryWhereValue = string | { gte: string; lt: string };
const where: Record<string, GalleryWhereValue> = {};
if (filterCategory !== "all") {
  where.category = await resolveBaseTermSlug("category", filterCategory, locale);
}
const periodRange = galleryPeriodRange(selectedPeriod);
if (periodRange) where.date = periodRange;
if (selectedLocation) where.location = selectedLocation.referenceId;

const { entries } = await getEmDashCollection("gallery", {
  status: "published",
  locale: "pt",
  where: Object.keys(where).length > 0 ? where : undefined,
  orderBy: { date: "desc", title: "asc" },
});

const sortedGalleryItems = (entries as any[]).sort((a, b) => {
  if (a.data.date && b.data.date) {
    return String(b.data.date).localeCompare(String(a.data.date));
  }
  return (a.data.title as string).localeCompare(b.data.title as string);
});

const hasActiveFilters = Boolean(selectedYear || selectedLocation);

const galleryPath =
  filterCategory === "all"
    ? `/${locale}/gallery/`
    : `/${locale}/gallery/${encodeURIComponent(filterCategory)}/`;

interface FilterState {
  category?: string;
  location?: string;
  year?: string;
  month?: string;
}

// Build a gallery URL from the current filters plus overrides. An override
// set to "" clears that filter; a cleared year always clears the month too.
const filterHref = (overrides: FilterState = {}) => {
  const category = overrides.category ?? filterCategory;
  const location = overrides.location ?? selectedLocation?.slug ?? "";
  const year = overrides.year ?? selectedYear;
  const month = year ? (overrides.month ?? selectedMonth) : "";
  const search = new URLSearchParams();
  if (location) search.set("location", location);
  if (year) search.set("year", year);
  if (year && month) search.set("month", month);
  const path =
    category === "all"
      ? `/${locale}/gallery/`
      : `/${locale}/gallery/${encodeURIComponent(category)}/`;
  return search.size > 0 ? `${path}?${search}` : path;
};
---

<main class="space-y-20">
  <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-3">
    <div class="text-center mb-4">
      <h1 class="text-5xl font-bold mb-4">{m.gallery_title}</h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        {m.gallery_description}
      </p>
    </div>

    <div
      class="mx-auto mb-8 flex max-w-4xl flex-wrap items-center justify-center gap-3"
      id="gallery-filters"
    >
      <details class="gallery-dropdown relative" data-dropdown>
        <summary
          class={`flex min-h-12 cursor-pointer select-none list-none items-center gap-2 rounded-full border-2 px-5 font-medium transition ${
            selectedLocation
              ? "border-dark bg-dark text-white shadow-[0_4px_0_0_#b9ff66]"
              : "border-gray-300 bg-white hover:border-gray-400"
          }`}
        >
          <span class="text-sm opacity-70">{m.gallery_filter_location}</span>
          <span>{selectedLocation ? selectedLocation.data.city : m.gallery_filter_all_locations}</span>
          <svg class="size-4 shrink-0 transition-transform" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="absolute left-1/2 z-20 mt-2 w-56 -translate-x-1/2 overflow-hidden rounded-2xl border-2 border-dark bg-white shadow-[0_6px_0_0_#b9ff66]">
          <div class="max-h-80 overflow-y-auto p-2 [scrollbar-width:thin]">
          <a
            href={filterHref({ location: "" })}
            class={`block rounded-xl px-4 py-2.5 transition hover:bg-green/30 ${!selectedLocation ? "bg-dark text-white" : ""}`}
          >
            {m.gallery_filter_all_locations}
          </a>
          {locations.map((location) => (
            <a
              href={filterHref({ location: location.slug })}
              class={`block rounded-xl px-4 py-2.5 transition hover:bg-green/30 ${
                selectedLocation?.slug === location.slug ? "bg-dark text-white" : ""
              }`}
            >
              {location.data.city}
            </a>
          ))}
          </div>
        </div>
      </details>

      <details class="gallery-dropdown relative" data-dropdown>
        <summary
          class={`flex min-h-12 cursor-pointer select-none list-none items-center gap-2 rounded-full border-2 px-5 font-medium transition ${
            selectedYear
              ? "border-dark bg-dark text-white shadow-[0_4px_0_0_#b9ff66]"
              : "border-gray-300 bg-white hover:border-gray-400"
          }`}
        >
          <span class="text-sm opacity-70">{m.gallery_filter_year}</span>
          <span>{selectedYear || m.gallery_filter_all_years}</span>
          <svg class="size-4 shrink-0 transition-transform" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="absolute left-1/2 z-20 mt-2 w-44 -translate-x-1/2 overflow-hidden rounded-2xl border-2 border-dark bg-white shadow-[0_6px_0_0_#b9ff66]">
          <div class="max-h-80 overflow-y-auto p-2 [scrollbar-width:thin]">
          <a
            href={filterHref({ year: "" })}
            class={`block rounded-xl px-4 py-2.5 transition hover:bg-green/30 ${!selectedYear ? "bg-dark text-white" : ""}`}
          >
            {m.gallery_filter_all_years}
          </a>
          {years.map((year) => (
            <a
              href={filterHref({ year })}
              class={`block rounded-xl px-4 py-2.5 tabular-nums transition hover:bg-green/30 ${
                selectedYear === year ? "bg-dark text-white" : ""
              }`}
            >
              {year}
            </a>
          ))}
          </div>
        </div>
      </details>

      {selectedYear && (
        <details class="gallery-dropdown relative" data-dropdown>
          <summary
            class={`flex min-h-12 cursor-pointer select-none list-none items-center gap-2 rounded-full border-2 px-5 font-medium transition ${
              selectedMonth
                ? "border-dark bg-dark text-white shadow-[0_4px_0_0_#b9ff66]"
                : "border-gray-300 bg-white hover:border-gray-400"
            }`}
          >
            <span class="text-sm opacity-70">{m.gallery_filter_month}</span>
            <span>{selectedMonth ? monthName(selectedMonth) : m.gallery_filter_all_months}</span>
            <svg class="size-4 shrink-0 transition-transform" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="absolute left-1/2 z-20 mt-2 w-48 -translate-x-1/2 overflow-hidden rounded-2xl border-2 border-dark bg-white shadow-[0_6px_0_0_#b9ff66]">
            <div class="max-h-80 overflow-y-auto p-2 [scrollbar-width:thin]">
            <a
              href={filterHref({ month: "" })}
              class={`block rounded-xl px-4 py-2.5 transition hover:bg-green/30 ${!selectedMonth ? "bg-dark text-white" : ""}`}
            >
              {m.gallery_filter_all_months}
            </a>
            {months.map((month) => (
              <a
                href={filterHref({ month })}
                class={`block rounded-xl px-4 py-2.5 transition hover:bg-green/30 ${
                  selectedMonth === month ? "bg-dark text-white" : ""
                }`}
              >
                {monthName(month)}
              </a>
            ))}
            </div>
          </div>
        </details>
      )}

      {hasActiveFilters && (
        <a
          href={galleryPath}
          class="rounded-lg px-2 py-3 text-sm underline decoration-green decoration-2 underline-offset-4 hover:text-green"
        >
          {m.gallery_filter_clear}
        </a>
      )}
    </div>

    {categoryTerms.length > 0 && (
      <div class="flex flex-wrap justify-center gap-3 mb-8">
        <a
          href={filterHref({ category: "all" })}
          class={`px-4 py-2 rounded-full border-2 transition-colors ${
            filterCategory === "all"
              ? "bg-black text-white border-black"
              : "border-gray-300 hover:border-gray-400"
          }`}
        >
          {m.gallery_all_categories}
        </a>
        {categoryTerms.map((term) => {
          const isActive = filterCategory === term.slug;
          return (
            <a
              href={filterHref({ category: term.slug })}
              class={`px-4 py-2 rounded-full border-2 transition-colors capitalize ${
                isActive
                  ? "bg-black text-white border-black"
                  : "border-gray-300 hover:border-gray-400"
              }`}
            >
              {capitalize(term.label)}
            </a>
          );
        })}
      </div>
    )}

    <div class="columns-1 md:columns-2 lg:columns-3 xl:columns-4 gap-6 space-y-6" id="gallery-grid">
      {
        sortedGalleryItems.map((galleryItem) => (
          <div class="break-inside-avoid mb-6">
            <GalleryCard galleryItem={galleryItem} />
          </div>
        ))
      }
    </div>

    {sortedGalleryItems.length === 0 && (
      <div class="text-center py-12">
        <p class="text-gray-500 text-lg">
          {hasActiveFilters ? m.gallery_no_results : m.gallery_no_images}
        </p>
      </div>
    )}
  </div>
</main>
<ImageModal id="gallery-modal" />

<style>
  .gallery-dropdown summary::-webkit-details-marker {
    display: none;
  }
  .gallery-dropdown[open] summary svg {
    transform: rotate(180deg);
  }
</style>

<script>
  // One dropdown open at a time; close on outside click and Escape.
  const dropdowns = document.querySelectorAll<HTMLDetailsElement>("#gallery-filters [data-dropdown]");
  for (const dropdown of dropdowns) {
    dropdown.addEventListener("toggle", () => {
      if (!dropdown.open) return;
      for (const other of dropdowns) {
        if (other !== dropdown) other.open = false;
      }
    });
  }
  document.addEventListener("click", (event) => {
    for (const dropdown of dropdowns) {
      if (dropdown.open && !dropdown.contains(event.target as Node)) dropdown.open = false;
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    for (const dropdown of dropdowns) dropdown.open = false;
  });
</script>

<script>
  // Make global function for tag clicks - navigate to filtered page
  window.filterByTag = (tag: string) => {
    const currentLocale = document.documentElement.lang || 'pt';
    const nextUrl = new URL(window.location.href);
    nextUrl.pathname = tag === 'all'
      ? `/${currentLocale}/gallery/`
      : `/${currentLocale}/gallery/${encodeURIComponent(tag)}/`;
    window.location.href = `${nextUrl.pathname}${nextUrl.search}`;
  };
</script>
