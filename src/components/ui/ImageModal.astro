---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div id={id} class="image-modal fixed inset-0 bg-black bg-opacity-90 z-50 flex items-center justify-center opacity-0 invisible transition-all duration-300 backdrop-blur-sm select-none" role="dialog" aria-modal="true">
  <div class="relative max-w-screen-lg max-h-[100vh] p-4 flex flex-col gap-4">
    <button class="absolute top-4 right-4 text-black size-10 text-4xl transition-colors z-10 bg-radial-white" aria-label="Close modal">
      &times;
    </button>
    <img class="max-w-full max-h-[calc(100vh-6rem)] object-contain flex-shrink-0 select-none pointer-events-none no-drag" id="modal-image" />
    <div class="text-white flex justify-between text-left select-none pointer-events-none">
      <h3 class="text-lg font-medium mb-2" id="modal-title"></h3>
      <div id="modal-author" class="text-sm text-gray-300 cursor-pointer"></div>
    </div>
  </div>
</div>

<script>
  // Everything queries the DOM at call time and binds at the document level,
  // so the lightbox keeps working after ClientRouter swaps the page.
  const getModal = () => document.querySelector<HTMLElement>('.image-modal');

  function closeModal() {
    const modal = getModal();
    if (modal) {
      modal.classList.add('opacity-0', 'invisible');
      document.body.style.overflow = '';
    }
  }

  window.openImageModal = (
    imageSrc: string,
    imageAlt: string,
    authorName?: string,
    authorLink?: string,
  ) => {
    const modal = getModal();
    const modalImg = modal?.querySelector<HTMLImageElement>('#modal-image');
    const modalTitle = modal?.querySelector<HTMLElement>('#modal-title');
    const modalAuthor = modal?.querySelector<HTMLElement>('#modal-author');
    if (!modal || !modalImg || !modalTitle || !modalAuthor) return;

    modalImg.src = imageSrc;
    modalImg.alt = imageAlt;
    modalTitle.textContent = imageAlt;

    // Handle author display (using DOM API to prevent XSS)
    modalAuthor.textContent = '';
    if (authorName) {
      const byText = document.createTextNode('By ');
      modalAuthor.appendChild(byText);
      if (authorLink && (authorLink.startsWith('https://') || authorLink.startsWith('http://'))) {
        const a = document.createElement('a');
        a.href = authorLink;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.className = 'hover:text-white underline decoration-dotted underline-offset-2 pointer-events-auto';
        a.textContent = authorName;
        modalAuthor.appendChild(a);
      } else {
        modalAuthor.appendChild(document.createTextNode(authorName));
      }
    }

    modal.classList.remove('opacity-0', 'invisible');
    document.body.style.overflow = 'hidden';
  };

  document.addEventListener('click', (event) => {
    const modal = getModal();
    if (!modal || modal.classList.contains('invisible')) return;
    const target = event.target as HTMLElement;
    if (target === modal || target.closest('.image-modal button')) closeModal();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const modal = getModal();
    if (modal && !modal.classList.contains('invisible')) closeModal();
  });
</script>
